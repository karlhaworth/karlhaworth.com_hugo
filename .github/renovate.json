{
  "extends": ["config:base"],
  "enabledManagers": ["gomod", "npm", "github-actions"],
  "regexManagers": [
    {
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["HUGO_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"] ,
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gohugoio/hugo",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["peaceiris/actions-hugo"],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPaths": ["^go.mod$"],
      "schedule": ["daily"]
    },
    {
      "matchManagers": ["npm"],
      "matchPaths": ["^package.json$", "^themes/karlhaworth-com/package.json$"],
      "schedule": ["daily"]
    }
  ]
}
